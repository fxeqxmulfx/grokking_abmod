;; Dense trainer for 128 channels; the build specializes the wide model.
;; Shared E, Rotate90, one RMSNorm -> Dense -> ReLU residual branch, tied readout.
;; Activation buffers hold four row slots; slot r starts r row strides in.
(module
  (memory (export "memory") 11 11)
  (global $weights (export "weights") i32 (i32.const 0))
  (global $gradient (export "gradient") i32 (i32.const 115200))
  (global $moment1 i32 (i32.const 230400))
  (global $moment2 i32 (i32.const 345600))
  (global $data (export "data") i32 (i32.const 460800))
  (global $samples (export "samples") i32 (i32.const 572544))
  (global $readout i32 (i32.const 574592))
  (global $readout_gradient i32 (i32.const 625792))
  (global $states i32 (i32.const 676992))
  (global $normalized i32 (i32.const 681088))
  (global $branches i32 (i32.const 685184))
  (global $inverse i32 (i32.const 687232))
  (global $dh i32 (i32.const 687296))
  (global $dn i32 (i32.const 689344))
  (global $temporary i32 (i32.const 691392))
  (global $logits (export "logits") i32 (i32.const 693440))
  (global $errors i32 (i32.const 695040))
  (global $metrics (export "metrics") i32 (i32.const 696640))
  (global $statistics (export "statistics") i32 (i32.const 696656))
  (global $input i32 (i32.const 676992))
  (global $hidden i32 (i32.const 677504))
  (global $winner (mut i32) (i32.const 0))

  (func $exp (export "exp_negative") (param $x f32) (result f32)
    (local $n i32) (local $r f32) (local $p f32)
    (if (f32.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
    (if (f32.lt (local.get $x) (f32.const -87.336544)) (then (return (f32.const 0))))
    (local.set $n (i32.trunc_f32_s (f32.nearest (f32.mul (local.get $x) (f32.const 1.4426950408889634)))))
    (local.set $r (f32.sub (f32.sub (local.get $x) (f32.mul (f32.convert_i32_s (local.get $n)) (f32.const 0.693359375)))
      (f32.mul (f32.convert_i32_s (local.get $n)) (f32.const -0.00021219444005469058))))
    (local.set $p (f32.const 0.0001984126984126984))
    (local.set $p (f32.add (f32.const 0.001388888888888889) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.008333333333333333) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.041666666666666664) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.16666666666666666) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.5) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $r) (local.get $p))))
    (f32.mul (local.get $p) (f32.reinterpret_i32 (i32.shl (i32.add (local.get $n) (i32.const 127)) (i32.const 23))))
  )
  (func $log (export "log_positive") (param $x f32) (result f32)
    (local $bits i32) (local $exponent i32) (local $m f32) (local $y f32) (local $square f32) (local $p f32)
    (local.set $bits (i32.reinterpret_f32 (local.get $x)))
    (local.set $exponent (i32.sub (i32.shr_u (local.get $bits) (i32.const 23)) (i32.const 127)))
    (local.set $m (f32.reinterpret_i32 (i32.or (i32.and (local.get $bits) (i32.const 8388607)) (i32.const 1065353216))))
    (local.set $y (f32.div (f32.sub (local.get $m) (f32.const 1)) (f32.add (local.get $m) (f32.const 1))))
    (local.set $square (f32.mul (local.get $y) (local.get $y)))
    (local.set $p (f32.const 0.058823529411764705))
    (local.set $p (f32.add (f32.const 0.06666666666666667) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.07692307692307693) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.09090909090909091) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.1111111111111111) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.14285714285714285) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.2) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.3333333333333333) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $square) (local.get $p))))
    (f32.add (f32.mul (f32.convert_i32_s (local.get $exponent)) (f32.const 0.6931471805599453))
      (f32.mul (f32.const 2) (f32.mul (local.get $y) (local.get $p))))
  )

  ;; @VECTOR_KERNELS

  ;; @ROTARY_KERNELS

  (func $prepare (export "prepare")
    (local $c i32) (local $k i32)
    (call $clear (global.get $readout) (i32.const 12800))
    (loop $channels
      (local.set $k (i32.const 0))
      (loop $classes
        (f32.store (i32.add (global.get $readout) (i32.mul (i32.add (i32.mul (local.get $c) (i32.const 100)) (local.get $k)) (i32.const 4)))
          (f32.load (i32.mul (i32.add (i32.mul (local.get $k) (i32.const 128)) (local.get $c)) (i32.const 4))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $classes (i32.lt_u (local.get $k) (i32.const 97))))
      (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $channels (i32.lt_u (local.get $c) (i32.const 128)))))
  (func (export "add_gradient") (param $source i32)
    (call $axpy (global.get $gradient) (local.get $source) (i32.const 28800) (f32.const 1)))
  ;; @MATRIX_KERNELS
  (func $matrix_back (param $gradient i32) (param $dx i32) (param $x i32) (param $dy i32) (param $matrix i32) (param $inputs i32) (param $outputs i32)
    (local $i i32) (local $at i32) (local $value f32)
    (loop $rows
      (local.set $at (i32.mul (i32.mul (local.get $i) (local.get $outputs)) (i32.const 4)))
      (f32.store (i32.add (local.get $dx) (i32.mul (local.get $i) (i32.const 4)))
        (call $dot (i32.add (local.get $matrix) (local.get $at)) (local.get $dy) (local.get $outputs)))
      (local.set $value (f32.load (i32.add (local.get $x) (i32.mul (local.get $i) (i32.const 4)))))
      (if (f32.ne (local.get $value) (f32.const 0)) (then (call $axpy (i32.add (local.get $gradient) (local.get $at)) (local.get $dy) (local.get $outputs) (local.get $value))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $i) (local.get $inputs)))))
  (func $norm (param $x i32) (param $dst i32) (result f32)
    (local $r f32)
    (local.set $r (f32.div (f32.const 1) (f32.sqrt (f32.add (f32.div (call $dot (local.get $x) (local.get $x) (i32.const 128)) (f32.const 128)) (f32.const 0.00001)))))
    (memory.copy (local.get $dst) (local.get $x) (i32.const 512))
    (call $multiply (local.get $dst) (i32.const 128) (local.get $r))
    (local.get $r))
  (func $norm_back (param $normalized i32) (param $dy i32) (param $dx i32) (param $r f32)
    (local $dot f32)
    (local.set $dot (f32.div (call $dot (local.get $normalized) (local.get $dy) (i32.const 128)) (f32.const 128)))
    (memory.copy (local.get $dx) (local.get $dy) (i32.const 512))
    (call $axpy (local.get $dx) (local.get $normalized) (i32.const 128) (f32.neg (local.get $dot)))
    (call $multiply (local.get $dx) (i32.const 128) (local.get $r)))

  ;; @RELU_KERNELS

  (func $forward (export "forward") (param $id i32)
    (local $row i32) (local $a i32) (local $b i32)
    (if (i32.ge_u (local.get $id) (i32.const 9312)) (then unreachable))
    (local.set $row (i32.add (global.get $data) (i32.mul (local.get $id) (i32.const 12))))
    (local.set $a (i32.load (local.get $row))) (local.set $b (i32.load offset=4 (local.get $row)))
    (if (i32.or (i32.ge_u (local.get $a) (i32.const 97)) (i32.ge_u (local.get $b) (i32.const 97))) (then unreachable))
    (memory.copy (global.get $states) (i32.mul (local.get $a) (i32.const 512)) (i32.const 512))
    (call $rotary_add (global.get $states) (i32.mul (local.get $b) (i32.const 512)) (i32.const 0))
    (f32.store (global.get $inverse) (call $norm (global.get $states) (global.get $normalized)))
    (call $matrix (global.get $branches) (global.get $normalized) (i32.const 49664) (i32.const 128) (i32.const 128))
    (call $relu_add (global.get $hidden) (global.get $states) (global.get $branches))
    (f32.store offset=4 (global.get $inverse) (call $norm (global.get $hidden) (i32.add (global.get $normalized) (i32.const 512))))
    (call $matrix (global.get $logits) (i32.add (global.get $normalized) (i32.const 512)) (global.get $readout) (i32.const 128) (i32.const 100)))

  ;; $slot is the byte offset of the row slot in logits and errors.
  (func $softmax (param $target i32) (param $scale f32) (param $slot i32) (result f32)
    (local $k i32) (local $maximum f32) (local $denominator f32)
    (local $row_logits i32) (local $row_errors i32)
    (if (i32.ge_u (local.get $target) (i32.const 97)) (then unreachable))
    (local.set $row_logits (i32.add (global.get $logits) (local.get $slot)))
    (local.set $row_errors (i32.add (global.get $errors) (local.get $slot)))
    (local.set $maximum (call $maximum (local.get $slot)))
    (call $exponentials (local.get $maximum) (local.get $slot))
    (local.set $k (i32.const 0))
    (loop $sum
      (local.set $denominator (f32.add (local.get $denominator) (f32.load (i32.add (local.get $row_errors) (i32.mul (local.get $k) (i32.const 4))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $sum (i32.lt_u (local.get $k) (i32.const 97))))
    (if (f32.ne (local.get $scale) (f32.const 0))
      (then
        (call $multiply (local.get $row_errors) (i32.const 100) (f32.div (local.get $scale) (local.get $denominator)))
        (f32.store (i32.add (local.get $row_errors) (i32.mul (local.get $target) (i32.const 4)))
          (f32.sub (f32.load (i32.add (local.get $row_errors) (i32.mul (local.get $target) (i32.const 4)))) (local.get $scale)))))
    (f32.sub (f32.add (call $log (local.get $denominator)) (local.get $maximum))
      (f32.load (i32.add (local.get $row_logits) (i32.mul (local.get $target) (i32.const 4)))))
  )

  (func $gradient_row (param $row i32) (param $scale f32)
    (local $id i32) (local $a i32) (local $b i32) (local $target i32) (local $at i32)
    (local.set $id (i32.load (i32.add (global.get $samples) (i32.mul (local.get $row) (i32.const 4)))))
    (if (i32.ge_u (local.get $id) (i32.const 4656)) (then unreachable))
    (local.set $at (i32.add (global.get $data) (i32.mul (local.get $id) (i32.const 12))))
    (local.set $a (i32.load (local.get $at))) (local.set $b (i32.load offset=4 (local.get $at)))
    (local.set $target (i32.load offset=8 (local.get $at)))
    (call $forward (local.get $id)) (call $softmax (local.get $target) (local.get $scale) (i32.const 0)) drop
    (call $matrix_back (global.get $readout_gradient) (global.get $dn) (i32.add (global.get $normalized) (i32.const 512)) (global.get $errors) (global.get $readout) (i32.const 128) (i32.const 100))
    (call $norm_back (i32.add (global.get $normalized) (i32.const 512)) (global.get $dn) (global.get $dh) (f32.load offset=4 (global.get $inverse)))
    ;; Keep dh for the skip. Differentiate ReLU, the dense matrix and RMSNorm.
    (call $relu_back (global.get $dn) (global.get $branches) (global.get $dh))
    (call $matrix_back (i32.add (global.get $gradient) (i32.const 49664)) (global.get $temporary) (global.get $normalized) (global.get $dn) (i32.const 49664) (i32.const 128) (i32.const 128))
    (call $norm_back (global.get $normalized) (global.get $temporary) (global.get $dn) (f32.load (global.get $inverse)))
    (call $axpy (global.get $dh) (global.get $dn) (i32.const 128) (f32.const 1))
    (call $axpy (i32.add (global.get $gradient) (i32.mul (local.get $a) (i32.const 512))) (global.get $dh) (i32.const 128) (f32.const 1))
    (call $rotary_add (i32.add (global.get $gradient) (i32.mul (local.get $b) (i32.const 512))) (global.get $dh) (i32.const 1)))
  ;; Add one row's loss and accuracy to the statistics of its split.
  (func $tally (param $id i32) (param $loss f32) (param $correct i32)
    (if (i32.lt_u (local.get $id) (i32.const 4656))
      (then (f64.store (global.get $statistics) (f64.add (f64.load (global.get $statistics)) (f64.promote_f32 (local.get $loss))))
        (i32.store offset=16 (global.get $statistics) (i32.add (i32.load offset=16 (global.get $statistics)) (local.get $correct))))
      (else (f64.store offset=8 (global.get $statistics) (f64.add (f64.load offset=8 (global.get $statistics)) (f64.promote_f32 (local.get $loss))))
        (i32.store offset=20 (global.get $statistics) (i32.add (i32.load offset=20 (global.get $statistics)) (local.get $correct))))))
  ;; Record one row; $slot selects its logits.
  (func $record (param $id i32) (param $slot i32)
    (local $target i32) (local $loss f32)
    (local.set $target (i32.load (i32.add (global.get $data) (i32.add (i32.mul (local.get $id) (i32.const 12)) (i32.const 8)))))
    (local.set $loss (call $softmax (local.get $target) (f32.const 0) (local.get $slot)))
    (call $tally (local.get $id) (local.get $loss) (i32.eq (global.get $winner) (local.get $target))))

  ;; @ROW_KERNELS

  (func $gradient_batch_scaled (export "gradient_batch_scaled") (param $rows i32) (param $scale f32)
    (local $row i32) (local $c i32) (local $k i32)
    (if (i32.or (i32.eqz (local.get $rows)) (i32.gt_u (local.get $rows) (i32.const 512))) (then unreachable))
    (call $clear (global.get $gradient) (i32.const 28800))
    (call $clear (global.get $readout_gradient) (i32.const 12800))
    ;; Row groups share matrix loads; the remaining rows take the single-row path.
    (local.set $row (call $gradient_groups (local.get $rows) (local.get $scale)))
    (if (i32.lt_u (local.get $row) (local.get $rows)) (then
      (loop $batch
        (call $gradient_row (local.get $row) (local.get $scale))
        (local.set $row (i32.add (local.get $row) (i32.const 1))) (br_if $batch (i32.lt_u (local.get $row) (local.get $rows))))))
    (loop $scatter_channels
      (local.set $k (i32.const 0))
      (loop $scatter_classes
        (f32.store (i32.add (global.get $gradient) (i32.mul (i32.add (i32.mul (local.get $k) (i32.const 128)) (local.get $c)) (i32.const 4)))
          (f32.add (f32.load (i32.add (global.get $gradient) (i32.mul (i32.add (i32.mul (local.get $k) (i32.const 128)) (local.get $c)) (i32.const 4))))
            (f32.load (i32.add (global.get $readout_gradient) (i32.mul (i32.add (i32.mul (local.get $c) (i32.const 100)) (local.get $k)) (i32.const 4))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $scatter_classes (i32.lt_u (local.get $k) (i32.const 97))))
      (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $scatter_channels (i32.lt_u (local.get $c) (i32.const 128)))))

  (func $gradient_batch (export "gradient_batch") (param $rows i32)
    (call $gradient_batch_scaled (local.get $rows) (f32.div (f32.const 1) (f32.convert_i32_u (local.get $rows)))))
  (func $apply_update (export "apply_update") (param $lr f32) (param $decay f32) (param $correction1 f32) (param $correction2 f32)
    (call $adam (local.get $lr) (local.get $decay) (local.get $correction1) (local.get $correction2))
    (call $prepare)
  )
  (func (export "step") (param $rows i32) (param $lr f32) (param $decay f32) (param $correction1 f32) (param $correction2 f32)
    (call $gradient_batch (local.get $rows))
    (call $apply_update (local.get $lr) (local.get $decay) (local.get $correction1) (local.get $correction2)))
  (func $evaluate_range (export "evaluate_range") (param $first i32) (param $end i32)
    (local $id i32)
    (if (i32.or (i32.ge_u (local.get $first) (local.get $end)) (i32.gt_u (local.get $end) (i32.const 9312))) (then unreachable))
    (f64.store (global.get $statistics) (f64.const 0))
    (f64.store offset=8 (global.get $statistics) (f64.const 0))
    (i64.store offset=16 (global.get $statistics) (i64.const 0))
    (local.set $id (call $evaluate_groups (local.get $first) (local.get $end)))
    (if (i32.lt_u (local.get $id) (local.get $end)) (then
      (loop $row
        (call $forward (local.get $id))
        (call $record (local.get $id) (i32.const 0))
        (local.set $id (i32.add (local.get $id) (i32.const 1))) (br_if $row (i32.lt_u (local.get $id) (local.get $end))))))
  )
  (func (export "evaluate")
    (call $evaluate_range (i32.const 0) (i32.const 9312))
    (f32.store (global.get $metrics) (f32.demote_f64 (f64.div (f64.load (global.get $statistics)) (f64.const 4656))))
    (f32.store offset=4 (global.get $metrics) (f32.div (f32.convert_i32_u (i32.load offset=16 (global.get $statistics))) (f32.const 4656)))
    (f32.store offset=8 (global.get $metrics) (f32.demote_f64 (f64.div (f64.load offset=8 (global.get $statistics)) (f64.const 4656))))
    (f32.store offset=12 (global.get $metrics) (f32.div (f32.convert_i32_u (i32.load offset=20 (global.get $statistics))) (f32.const 4656))))
)
