;; Handwritten shared-E concat / W128 Square Neighbor residual mesh.
;; E is shared by both operands and the transposed readout, with one AdamW state.
;; Layout matches Rust: E [97,128], A [256,128], then six [self,neighbor] meshes.
(module
  (memory (export "memory") 18 18)
  (global $weights (export "weights") i32 (i32.const 0))
  (global $gradient (export "gradient") i32 (i32.const 186880))
  (global $moment1 i32 (i32.const 373760))
  (global $moment2 i32 (i32.const 560640))
  (global $data (export "data") i32 (i32.const 747520))
  (global $samples (export "samples") i32 (i32.const 859264))
  (global $readout i32 (i32.const 861312))
  (global $readout_gradient i32 (i32.const 912512))
  (global $states i32 (i32.const 963712))
  (global $normalized i32 (i32.const 965248))
  (global $branches i32 (i32.const 966784))
  (global $inverse i32 (i32.const 968832))
  (global $dh i32 (i32.const 968848))
  (global $dn i32 (i32.const 969360))
  (global $temporary i32 (i32.const 969872))
  (global $logits (export "logits") i32 (i32.const 970384))
  (global $errors i32 (i32.const 970784))
  (global $metrics (export "metrics") i32 (i32.const 971184))
  (global $input i32 (i32.const 963712))
  (global $hidden i32 (i32.const 964736))
  (global $products i32 (i32.const 968832))
  (global $projected i32 (i32.const 971200))
  (global $projected_gradient i32 (i32.const 1070528))
  (global $winner (mut i32) (i32.const 0))

  (func $exp (export "exp_negative") (param $x f32) (result f32)
    (local $n i32) (local $r f32) (local $p f32)
    (if (f32.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))
    (if (f32.lt (local.get $x) (f32.const -87.336544)) (then (return (f32.const 0))))
    (local.set $n (i32.trunc_f32_s (f32.nearest (f32.mul (local.get $x) (f32.const 1.4426950408889634)))))
    (local.set $r (f32.sub (f32.sub (local.get $x) (f32.mul (f32.convert_i32_s (local.get $n)) (f32.const 0.693359375)))
      (f32.mul (f32.convert_i32_s (local.get $n)) (f32.const -0.00021219444005469058))))
    (local.set $p (f32.const 0.0001984126984126984))
    (local.set $p (f32.add (f32.const 0.001388888888888889) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.008333333333333333) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.041666666666666664) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.16666666666666666) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.5) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $r) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $r) (local.get $p))))
    (f32.mul (local.get $p) (f32.reinterpret_i32 (i32.shl (i32.add (local.get $n) (i32.const 127)) (i32.const 23))))
  )
  (func $log (export "log_positive") (param $x f32) (result f32)
    (local $bits i32) (local $exponent i32) (local $m f32) (local $y f32) (local $square f32) (local $p f32)
    (local.set $bits (i32.reinterpret_f32 (local.get $x)))
    (local.set $exponent (i32.sub (i32.shr_u (local.get $bits) (i32.const 23)) (i32.const 127)))
    (local.set $m (f32.reinterpret_i32 (i32.or (i32.and (local.get $bits) (i32.const 8388607)) (i32.const 1065353216))))
    (local.set $y (f32.div (f32.sub (local.get $m) (f32.const 1)) (f32.add (local.get $m) (f32.const 1))))
    (local.set $square (f32.mul (local.get $y) (local.get $y)))
    (local.set $p (f32.const 0.058823529411764705))
    (local.set $p (f32.add (f32.const 0.06666666666666667) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.07692307692307693) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.09090909090909091) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.1111111111111111) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.14285714285714285) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.2) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 0.3333333333333333) (f32.mul (local.get $square) (local.get $p))))
    (local.set $p (f32.add (f32.const 1) (f32.mul (local.get $square) (local.get $p))))
    (f32.add (f32.mul (f32.convert_i32_s (local.get $exponent)) (f32.const 0.6931471805599453))
      (f32.mul (f32.const 2) (f32.mul (local.get $y) (local.get $p))))
  )

  ;; @VECTOR_KERNELS

  (func $project_inputs
    (local $operand i32) (local $residue i32) (local $feature i32) (local $row i32)
    (call $clear (global.get $projected) (i32.const 24832))
    (loop $operand_loop
      (local.set $residue (i32.const 0))
      (loop $residue_loop
        (local.set $row (i32.add (global.get $projected) (i32.mul (i32.add (i32.mul (local.get $operand) (i32.const 97)) (local.get $residue)) (i32.const 512))))
        (local.set $feature (i32.const 0))
        (loop $feature_loop
          (call $axpy (local.get $row)
            (i32.add (i32.const 49664) (i32.mul (i32.add (i32.mul (local.get $operand) (i32.const 128)) (local.get $feature)) (i32.const 512)))
            (i32.const 128)
            (f32.load (i32.add (i32.mul (local.get $residue) (i32.const 512)) (i32.mul (local.get $feature) (i32.const 4)))))
          (local.set $feature (i32.add (local.get $feature) (i32.const 1)))
          (br_if $feature_loop (i32.lt_u (local.get $feature) (i32.const 128))))
        (local.set $residue (i32.add (local.get $residue) (i32.const 1)))
        (br_if $residue_loop (i32.lt_u (local.get $residue) (i32.const 97))))
      (local.set $operand (i32.add (local.get $operand) (i32.const 1)))
      (br_if $operand_loop (i32.lt_u (local.get $operand) (i32.const 2))))
  )

  (func $projection_gradient
    (local $residue i32) (local $feature i32) (local $da i32) (local $db i32)
    (local $aa i32) (local $ab i32) (local $at i32) (local $value f32)
    (loop $residue_loop
      (local.set $da (i32.add (global.get $projected_gradient) (i32.mul (local.get $residue) (i32.const 512))))
      (local.set $db (i32.add (global.get $projected_gradient) (i32.mul (i32.add (local.get $residue) (i32.const 97)) (i32.const 512))))
      (local.set $feature (i32.const 0))
      (loop $feature_loop
        (local.set $aa (i32.add (i32.const 49664) (i32.mul (local.get $feature) (i32.const 512))))
        (local.set $ab (i32.add (i32.const 115200) (i32.mul (local.get $feature) (i32.const 512))))
        (local.set $at (i32.add (i32.mul (local.get $residue) (i32.const 512)) (i32.mul (local.get $feature) (i32.const 4))))
        (local.set $value (f32.load (local.get $at)))
        (f32.store (i32.add (global.get $gradient) (local.get $at))
          (f32.add (f32.load (i32.add (global.get $gradient) (local.get $at)))
            (f32.add (call $dot (local.get $da) (local.get $aa) (i32.const 128))
              (call $dot (local.get $db) (local.get $ab) (i32.const 128)))))
        (call $axpy (i32.add (global.get $gradient) (local.get $aa)) (local.get $da) (i32.const 128) (local.get $value))
        (call $axpy (i32.add (global.get $gradient) (local.get $ab)) (local.get $db) (i32.const 128) (local.get $value))
        (local.set $feature (i32.add (local.get $feature) (i32.const 1)))
        (br_if $feature_loop (i32.lt_u (local.get $feature) (i32.const 128))))
      (local.set $residue (i32.add (local.get $residue) (i32.const 1)))
      (br_if $residue_loop (i32.lt_u (local.get $residue) (i32.const 97))))
  )

  ;; Cache both input-role projections and the padded transposed embedding.
  (func $prepare (export "prepare")
    (local $c i32) (local $k i32)
    (call $project_inputs)
    (call $clear (global.get $readout) (i32.const 12800))
    (loop $channels
      (local.set $k (i32.const 0))
      (loop $classes
        (f32.store (i32.add (global.get $readout) (i32.mul (i32.add (i32.mul (local.get $c) (i32.const 100)) (local.get $k)) (i32.const 4)))
          (f32.load (i32.mul (i32.add (i32.mul (local.get $k) (i32.const 128)) (local.get $c)) (i32.const 4))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $classes (i32.lt_u (local.get $k) (i32.const 97))))
      (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $channels (i32.lt_u (local.get $c) (i32.const 128)))))
  (func $matrix (param $dst i32) (param $input i32) (param $matrix i32) (param $inputs i32) (param $outputs i32)
    (local $i i32) (local $value f32)
    (call $clear (local.get $dst) (local.get $outputs))
    (loop $rows
      (local.set $value (f32.load (i32.add (local.get $input) (i32.mul (local.get $i) (i32.const 4)))))
      (if (f32.ne (local.get $value) (f32.const 0)) (then
        (call $axpy (local.get $dst) (i32.add (local.get $matrix) (i32.mul (i32.mul (local.get $i) (local.get $outputs)) (i32.const 4))) (local.get $outputs) (local.get $value))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $i) (local.get $inputs)))))
  (func $matrix_back (param $gradient i32) (param $dx i32) (param $x i32) (param $dy i32) (param $matrix i32) (param $inputs i32) (param $outputs i32)
    (local $i i32) (local $at i32) (local $value f32)
    (loop $rows
      (local.set $at (i32.mul (i32.mul (local.get $i) (local.get $outputs)) (i32.const 4)))
      (f32.store (i32.add (local.get $dx) (i32.mul (local.get $i) (i32.const 4)))
        (call $dot (i32.add (local.get $matrix) (local.get $at)) (local.get $dy) (local.get $outputs)))
      (local.set $value (f32.load (i32.add (local.get $x) (i32.mul (local.get $i) (i32.const 4)))))
      (if (f32.ne (local.get $value) (f32.const 0)) (then (call $axpy (i32.add (local.get $gradient) (local.get $at)) (local.get $dy) (local.get $outputs) (local.get $value))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $i) (local.get $inputs)))))
  (func $norm (param $x i32) (param $dst i32) (result f32)
    (local $r f32)
    (local.set $r (f32.div (f32.const 1) (f32.sqrt (f32.add (f32.div (call $dot (local.get $x) (local.get $x) (i32.const 128)) (f32.const 128)) (f32.const 0.00001)))))
    (memory.copy (local.get $dst) (local.get $x) (i32.const 512))
    (call $multiply (local.get $dst) (i32.const 128) (local.get $r))
    (local.get $r))
  (func $norm_back (param $normalized i32) (param $dy i32) (param $dx i32) (param $r f32)
    (local $dot f32)
    (local.set $dot (f32.div (call $dot (local.get $normalized) (local.get $dy) (i32.const 128)) (f32.const 128)))
    (memory.copy (local.get $dx) (local.get $dy) (i32.const 512))
    (call $axpy (local.get $dx) (local.get $normalized) (i32.const 128) (f32.neg (local.get $dot)))
    (call $multiply (local.get $dx) (i32.const 128) (local.get $r)))

  ;; Every output reads two adjacent channels; the last channel wraps to zero.
  (func $mesh (param $dst i32) (param $x i32) (param $at i32) (param $square i32)
    (local $c i32) (local $address i32) (local $own f32) (local $next f32)
    (loop $channels
      (local.set $own (f32.load (i32.add (local.get $x) (i32.mul (local.get $c) (i32.const 4)))))
      (local.set $next (f32.load (i32.add (local.get $x) (i32.mul (i32.and (i32.add (local.get $c) (i32.const 1)) (i32.const 127)) (i32.const 4)))))
      (if (local.get $square) (then
        (local.set $own (f32.mul (local.get $own) (local.get $own)))
        (local.set $next (f32.mul (local.get $next) (local.get $next)))))
      (local.set $address (i32.add (local.get $at) (i32.mul (local.get $c) (i32.const 8))))
      (f32.store (i32.add (local.get $dst) (i32.mul (local.get $c) (i32.const 4)))
        (f32.add (f32.mul (local.get $own) (f32.load (local.get $address)))
                 (f32.mul (local.get $next) (f32.load offset=4 (local.get $address)))))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $channels (i32.lt_u (local.get $c) (i32.const 128)))))

  ;; Deterministic gathered transpose: dx[c] receives self and previous-channel
  ;; edges. Square uses 2*x even for negative inputs; no rectification occurs.
  (func $mesh_back (param $dx i32) (param $x i32) (param $dy i32) (param $at i32) (param $square i32)
    (local $c i32) (local $address i32) (local $previous i32)
    (local $raw f32) (local $own f32) (local $next f32) (local $delta f32) (local $derivative f32)
    (loop $channels
      (local.set $raw (f32.load (i32.add (local.get $x) (i32.mul (local.get $c) (i32.const 4)))))
      (local.set $own (local.get $raw))
      (local.set $next (f32.load (i32.add (local.get $x) (i32.mul (i32.and (i32.add (local.get $c) (i32.const 1)) (i32.const 127)) (i32.const 4)))))
      (if (local.get $square) (then
        (local.set $own (f32.mul (local.get $own) (local.get $own)))
        (local.set $next (f32.mul (local.get $next) (local.get $next)))))
      (local.set $address (i32.add (local.get $at) (i32.mul (local.get $c) (i32.const 8))))
      (local.set $delta (f32.load (i32.add (local.get $dy) (i32.mul (local.get $c) (i32.const 4)))))
      (f32.store (i32.add (global.get $gradient) (local.get $address))
        (f32.add (f32.load (i32.add (global.get $gradient) (local.get $address))) (f32.mul (local.get $own) (local.get $delta))))
      (f32.store offset=4 (i32.add (global.get $gradient) (local.get $address))
        (f32.add (f32.load offset=4 (i32.add (global.get $gradient) (local.get $address))) (f32.mul (local.get $next) (local.get $delta))))
      (local.set $previous (i32.and (i32.add (local.get $c) (i32.const 127)) (i32.const 127)))
      (local.set $derivative (f32.add
        (f32.mul (f32.load (local.get $address)) (local.get $delta))
        (f32.mul (f32.load offset=4 (i32.add (local.get $at) (i32.mul (local.get $previous) (i32.const 8))))
                 (f32.load (i32.add (local.get $dy) (i32.mul (local.get $previous) (i32.const 4)))))))
      (if (local.get $square) (then (local.set $derivative (f32.mul (f32.mul (f32.const 2) (local.get $raw)) (local.get $derivative)))))
      (f32.store (i32.add (local.get $dx) (i32.mul (local.get $c) (i32.const 4))) (local.get $derivative))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br_if $channels (i32.lt_u (local.get $c) (i32.const 128)))))

  (func $forward (export "forward") (param $id i32)
    (local $row i32) (local $a i32) (local $b i32) (local $block i32)
    (local $h i32) (local $n i32) (local $branch i32) (local $at i32)
    (if (i32.ge_u (local.get $id) (i32.const 9312)) (then unreachable))
    (local.set $row (i32.add (global.get $data) (i32.mul (local.get $id) (i32.const 12))))
    (local.set $a (i32.load (local.get $row))) (local.set $b (i32.load offset=4 (local.get $row)))
    (if (i32.or (i32.ge_u (local.get $a) (i32.const 97)) (i32.ge_u (local.get $b) (i32.const 97))) (then unreachable))
    (memory.copy (global.get $states) (i32.add (global.get $projected) (i32.mul (local.get $a) (i32.const 512))) (i32.const 512))
    (call $axpy (global.get $states) (i32.add (global.get $projected) (i32.mul (i32.add (i32.const 97) (local.get $b)) (i32.const 512))) (i32.const 128) (f32.const 1))
    (loop $blocks
      (local.set $h (i32.add (global.get $states) (i32.mul (local.get $block) (i32.const 512))))
      (local.set $n (i32.add (global.get $normalized) (i32.mul (local.get $block) (i32.const 512))))
      (local.set $branch (i32.add (global.get $branches) (i32.mul (local.get $block) (i32.const 1024))))
      (local.set $at (i32.add (i32.const 180736) (i32.mul (local.get $block) (i32.const 3072))))
      (f32.store (i32.add (global.get $inverse) (i32.mul (local.get $block) (i32.const 4))) (call $norm (local.get $h) (local.get $n)))
      (call $mesh (local.get $branch) (local.get $n) (local.get $at) (i32.const 0))
      (call $mesh (i32.add (local.get $branch) (i32.const 512)) (local.get $branch) (i32.add (local.get $at) (i32.const 1024)) (i32.const 1))
      (call $mesh (i32.add (local.get $h) (i32.const 512)) (i32.add (local.get $branch) (i32.const 512)) (i32.add (local.get $at) (i32.const 2048)) (i32.const 1))
      (call $axpy (i32.add (local.get $h) (i32.const 512)) (local.get $h) (i32.const 128) (f32.const 1))
      (local.set $block (i32.add (local.get $block) (i32.const 1))) (br_if $blocks (i32.lt_u (local.get $block) (i32.const 2))))
    (f32.store offset=8 (global.get $inverse) (call $norm (global.get $hidden) (i32.add (global.get $normalized) (i32.const 1024))))
    (call $matrix (global.get $logits) (i32.add (global.get $normalized) (i32.const 1024)) (global.get $readout) (i32.const 128) (i32.const 100)))

  (func $softmax (param $target i32) (param $scale f32) (result f32)
    (local $k i32) (local $winner i32) (local $maximum f32) (local $value f32) (local $denominator f32)
    (if (i32.ge_u (local.get $target) (i32.const 97)) (then unreachable))
    (local.set $maximum (f32.load (global.get $logits))) (local.set $k (i32.const 1))
    (loop $maximum_loop
      (local.set $value (f32.load (i32.add (global.get $logits) (i32.mul (local.get $k) (i32.const 4)))))
      (if (f32.gt (local.get $value) (local.get $maximum)) (then (local.set $maximum (local.get $value)) (local.set $winner (local.get $k))))
      (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $maximum_loop (i32.lt_u (local.get $k) (i32.const 97))))
    (call $exponentials (local.get $maximum))
    (local.set $k (i32.const 0))
    (loop $sum
      (local.set $denominator (f32.add (local.get $denominator) (f32.load (i32.add (global.get $errors) (i32.mul (local.get $k) (i32.const 4))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $sum (i32.lt_u (local.get $k) (i32.const 97))))
    (if (f32.ne (local.get $scale) (f32.const 0))
      (then
        (call $multiply (global.get $errors) (i32.const 100) (f32.div (local.get $scale) (local.get $denominator)))
        (f32.store (i32.add (global.get $errors) (i32.mul (local.get $target) (i32.const 4)))
          (f32.sub (f32.load (i32.add (global.get $errors) (i32.mul (local.get $target) (i32.const 4)))) (local.get $scale)))))
    (global.set $winner (local.get $winner))
    (f32.sub (f32.add (call $log (local.get $denominator)) (local.get $maximum))
      (f32.load (i32.add (global.get $logits) (i32.mul (local.get $target) (i32.const 4)))))
  )

  (func $gradient_batch (export "gradient_batch") (param $rows i32)
    (local $row i32) (local $id i32) (local $a i32) (local $b i32) (local $target i32) (local $block i32)
    (local $n i32) (local $branch i32) (local $at i32) (local $c i32) (local $k i32) (local $scale f32)
    (if (i32.or (i32.eqz (local.get $rows)) (i32.gt_u (local.get $rows) (i32.const 512))) (then unreachable))
    (call $clear (global.get $gradient) (i32.const 46720))
    (call $clear (global.get $readout_gradient) (i32.const 12800))
    (call $clear (global.get $projected_gradient) (i32.const 24832))
    (local.set $scale (f32.div (f32.const 1) (f32.convert_i32_u (local.get $rows))))
    (loop $batch
      (local.set $id (i32.load (i32.add (global.get $samples) (i32.mul (local.get $row) (i32.const 4)))))
      (if (i32.ge_u (local.get $id) (i32.const 4656)) (then unreachable))
      (local.set $at (i32.add (global.get $data) (i32.mul (local.get $id) (i32.const 12))))
      (local.set $a (i32.load (local.get $at))) (local.set $b (i32.add (i32.const 97) (i32.load offset=4 (local.get $at))))
      (local.set $target (i32.load offset=8 (local.get $at)))
      (call $forward (local.get $id)) (call $softmax (local.get $target) (local.get $scale)) drop
      (call $matrix_back (global.get $readout_gradient) (global.get $dn) (i32.add (global.get $normalized) (i32.const 1024)) (global.get $errors) (global.get $readout) (i32.const 128) (i32.const 100))
      (call $norm_back (i32.add (global.get $normalized) (i32.const 1024)) (global.get $dn) (global.get $dh) (f32.load offset=8 (global.get $inverse)))
      (local.set $block (i32.const 2))
      (loop $blocks
        (local.set $block (i32.sub (local.get $block) (i32.const 1)))
        (local.set $n (i32.add (global.get $normalized) (i32.mul (local.get $block) (i32.const 512))))
        (local.set $branch (i32.add (global.get $branches) (i32.mul (local.get $block) (i32.const 1024))))
        (local.set $at (i32.add (i32.const 180736) (i32.mul (local.get $block) (i32.const 3072))))
        (memory.copy (global.get $dn) (global.get $dh) (i32.const 512))
        (call $mesh_back (global.get $temporary) (i32.add (local.get $branch) (i32.const 512)) (global.get $dn) (i32.add (local.get $at) (i32.const 2048)) (i32.const 1))
        (call $mesh_back (global.get $dn) (local.get $branch) (global.get $temporary) (i32.add (local.get $at) (i32.const 1024)) (i32.const 1))
        (call $mesh_back (global.get $temporary) (local.get $n) (global.get $dn) (local.get $at) (i32.const 0))
        (call $norm_back (local.get $n) (global.get $temporary) (global.get $dn) (f32.load (i32.add (global.get $inverse) (i32.mul (local.get $block) (i32.const 4)))))
        (call $axpy (global.get $dh) (global.get $dn) (i32.const 128) (f32.const 1))
        (br_if $blocks (i32.gt_u (local.get $block) (i32.const 0))))
      (call $axpy (i32.add (global.get $projected_gradient) (i32.mul (local.get $a) (i32.const 512))) (global.get $dh) (i32.const 128) (f32.const 1))
      (call $axpy (i32.add (global.get $projected_gradient) (i32.mul (local.get $b) (i32.const 512))) (global.get $dh) (i32.const 128) (f32.const 1))
      (local.set $row (i32.add (local.get $row) (i32.const 1))) (br_if $batch (i32.lt_u (local.get $row) (local.get $rows))))
    (loop $scatter_channels
      (local.set $k (i32.const 0))
      (loop $scatter_classes
        (f32.store (i32.add (global.get $gradient) (i32.mul (i32.add (i32.mul (local.get $k) (i32.const 128)) (local.get $c)) (i32.const 4)))
          (f32.load (i32.add (global.get $readout_gradient) (i32.mul (i32.add (i32.mul (local.get $c) (i32.const 100)) (local.get $k)) (i32.const 4)))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br_if $scatter_classes (i32.lt_u (local.get $k) (i32.const 97))))
      (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $scatter_channels (i32.lt_u (local.get $c) (i32.const 128))))
    (call $projection_gradient))

  (func (export "step") (param $rows i32) (param $lr f32) (param $decay f32) (param $correction1 f32) (param $correction2 f32)
    (call $gradient_batch (local.get $rows))
    (call $adam (local.get $lr) (local.get $decay) (local.get $correction1) (local.get $correction2))
    (call $prepare)
  )
  (func (export "evaluate")
    (local $id i32) (local $target i32) (local $winner i32) (local $loss f32)
    (local $train_loss f64) (local $held_loss f64) (local $train_correct i32) (local $held_correct i32)
    (loop $row
      (local.set $target (i32.load (i32.add (global.get $data) (i32.add (i32.mul (local.get $id) (i32.const 12)) (i32.const 8)))))
      (call $forward (local.get $id))
      (local.set $loss (call $softmax (local.get $target) (f32.const 0)))
      (local.set $winner (global.get $winner))
      (if (i32.lt_u (local.get $id) (i32.const 4656))
        (then (local.set $train_loss (f64.add (local.get $train_loss) (f64.promote_f32 (local.get $loss))))
          (local.set $train_correct (i32.add (local.get $train_correct) (i32.eq (local.get $winner) (local.get $target)))))
        (else (local.set $held_loss (f64.add (local.get $held_loss) (f64.promote_f32 (local.get $loss))))
          (local.set $held_correct (i32.add (local.get $held_correct) (i32.eq (local.get $winner) (local.get $target))))))
      (local.set $id (i32.add (local.get $id) (i32.const 1))) (br_if $row (i32.lt_u (local.get $id) (i32.const 9312))))
    (f32.store (global.get $metrics) (f32.demote_f64 (f64.div (local.get $train_loss) (f64.const 4656))))
    (f32.store offset=4 (global.get $metrics) (f32.div (f32.convert_i32_u (local.get $train_correct)) (f32.const 4656)))
    (f32.store offset=8 (global.get $metrics) (f32.demote_f64 (f64.div (local.get $held_loss) (f64.const 4656))))
    (f32.store offset=12 (global.get $metrics) (f32.div (f32.convert_i32_u (local.get $held_correct)) (f32.const 4656)))
  )
)
