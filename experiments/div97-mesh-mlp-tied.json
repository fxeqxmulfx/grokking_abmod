    "weight-decay": 0.1,
    "model": "mesh-mlp",
    "activation": "relu",
    "encoding": "one-hot",
    "width": 64,
    "connectivity": "own",
    "tied-mesh": true
  },
  "candidates": [
    {"label": "mesh-mlp-own-w64-d5", "depth": 5, "tied-mesh": false},
    {"label": "mesh-mlp-own-tied-w64-d3", "depth": 3},
    {"label": "mesh-mlp-own-tied-w64-d5", "depth": 5},
    {"label": "mesh-mlp-own-tied-w64-d9", "depth": 9}
  ]
}
