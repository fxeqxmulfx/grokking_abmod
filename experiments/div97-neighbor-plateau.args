# Replicate the short-plateau Square residual Neighbor mesh on five independent seeds.
# Evaluate complete splits every epoch with --report-every 10; cap each run at 10,000 epochs.
# Parameters: 38,784, W128, two residual blocks, three mesh layers per branch.
grok-simple --model residual-mesh-mlp --width 128 --depth 2 --mesh-depth 3 --activation square --encoding one-hot --connectivity neighbor --mesh-learning-rate-multiplier 1 --learning-rate 0.001 --weight-decay 0.1 --seed 7
grok-simple --model residual-mesh-mlp --width 128 --depth 2 --mesh-depth 3 --activation square --encoding one-hot --connectivity neighbor --mesh-learning-rate-multiplier 1 --learning-rate 0.001 --weight-decay 0.1 --seed 8
grok-simple --model residual-mesh-mlp --width 128 --depth 2 --mesh-depth 3 --activation square --encoding one-hot --connectivity neighbor --mesh-learning-rate-multiplier 1 --learning-rate 0.001 --weight-decay 0.1 --seed 9
grok-simple --model residual-mesh-mlp --width 128 --depth 2 --mesh-depth 3 --activation square --encoding one-hot --connectivity neighbor --mesh-learning-rate-multiplier 1 --learning-rate 0.001 --weight-decay 0.1 --seed 10
grok-simple --model residual-mesh-mlp --width 128 --depth 2 --mesh-depth 3 --activation square --encoding one-hot --connectivity neighbor --mesh-learning-rate-multiplier 1 --learning-rate 0.001 --weight-decay 0.1 --seed 11
